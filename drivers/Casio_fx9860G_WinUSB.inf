; =========================================================================
; Casio fx-9860G Series Modern WinUSB Driver INF
; Enables Direct WebUSB (Chrome/Edge) and Python USB communication
; Hardware ID: USB\VID_07CF&PID_6101 (Casio fx-9860G / fx-9860GII / CESG502)
; =========================================================================

[Version]
Signature = "$Windows NT$"
Class = USBDevice
ClassGUID = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider = %ManufacturerName%
CatalogFile = Casio_fx9860G_WinUSB.cat
DriverVer = 10/25/2026, 2.0.0.0

[Manufacturer]
%ManufacturerName% = Standard, NTamd64, NTx86

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_07CF&PID_6101

[Standard.NTx86]
%DeviceName% = USB_Install, USB\VID_07CF&PID_6101

[USB_Install]
Include = winusb.inf
Needs = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
AddService = WinUSB, 0x00000002, WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName = "Casio fx-9860G WinUSB Driver Service"
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService = WINUSB, WinUSB_Install

[WinUSB_Install]
KmdfLibraryVersion = 1.11

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
ManufacturerName = "CASIO COMPUTER CO., LTD."
DeviceName = "Casio fx-9860GII USB Calculator (WinUSB Direct Access)"
